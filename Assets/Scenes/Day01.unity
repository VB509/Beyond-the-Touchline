  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 285
  indentLevel: 0
  storyText: Right. So telling the truth isn't allowed anymore. Got it.
  description: 
  character: {fileID: 440430131}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
