  text: I'm the manager, Lukas. Trust my judgement.
  description: 
  targetBlock: {fileID: 1544241382}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
