  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 6
  indentLevel: 0
  storyText: "\u201CMaybe we can make something of this.\u201D"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
