  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Menu
  itemId: 62
  indentLevel: 0
  text: Well, it's going to be difficult. Maybe even impossible, to be honest. I
    really don't know...
  description: 
  targetBlock: {fileID: 1544240986}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
