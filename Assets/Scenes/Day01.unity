  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 76
  indentLevel: 0
  storyText: 'Anyway, boss! Would you like me to show you the changing rooms? A few
    of the lads should be in there!

'
