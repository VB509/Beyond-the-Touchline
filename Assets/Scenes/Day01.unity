  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 51
  indentLevel: 0
  storyText: Well, well! Look who we've got here! Young Lukas Wolter! Promising lad,
    this one. Came all the way from Bremen, Germany, not long ago.
  description: 
  character: {fileID: 1758483713}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
