  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 604
  indentLevel: 0
  storyText: Right, lads! One final tactical session. Tomorrow I want everyone to
    know exactly what they're supposed to be doing.
