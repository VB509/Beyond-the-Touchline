  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Menu
  itemId: 95
  indentLevel: 0
  text: Well... maybe you've got a point. I suppose we'll have to wait and see.
  description: 
  targetBlock: {fileID: 1544241044}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
