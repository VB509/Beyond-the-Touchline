  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 595
  indentLevel: 0
  storyText: Alright, lads. Tomorrow everything we've worked on gets put to the test.
    We've got time for one final session. Let's make the right choice.
  description: 
  character: {fileID: 1688545919}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
