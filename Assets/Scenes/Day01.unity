  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 2
  indentLevel: 0
  storyText: "\u201CGood old Town. Down near the bottom, season after season. And
    now I\u2019m taking over.\u201D"
