  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 307
  indentLevel: 0
  storyText: What on earth am I paying you for if this is the result?! All that money,
    all those years wasted, and this place still looks like an absolute disgrace!
