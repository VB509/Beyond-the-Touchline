--- !u!114 &1544240990
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1544240921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Menu
  itemId: 61
  indentLevel: 0
  text: I'll do everything I can to get Bramwick Town back where it belongs. We're
    going to start winning again!
  description: 
  targetBlock: {fileID: 1544240987}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
  hideThisOption:
    booleanRef: {fileID: 0}
    booleanVal: 0
--- !u!114 &1544240991
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1544240921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Menu
  itemId: 60
  indentLevel: 0
  text: Of course! It'll take a lot of hard work and determination, but I can see
    you've got plenty of both.
  description: 
  targetBlock: {fileID: 1544240988}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
