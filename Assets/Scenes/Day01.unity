  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 664
  indentLevel: 0
  storyText: Come on, Bramwick!
  description: 
  character: {fileID: 72338734}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
