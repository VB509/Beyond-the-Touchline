  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Menu
  itemId: 23
  indentLevel: 0
  text: I couldn't stand seeing this club so far down. I never stopped following
    the team, never stopped supporting it. Now I want to be part of it again.
  description: 
  targetBlock: {fileID: 1544240940}
  hideIfVisited: 0
  interactable:
