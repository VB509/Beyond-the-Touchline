  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 321
  indentLevel: 0
  storyText: Cheers, lad. Finally, someone with a bit of common sense around here!
  description: 
  character: {fileID: 1758483713}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
