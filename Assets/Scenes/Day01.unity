  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 718
  indentLevel: 0
  storyText: ...Then we'll see you tomorrow, boss.
  description: 
  character: {fileID: 440430131}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
