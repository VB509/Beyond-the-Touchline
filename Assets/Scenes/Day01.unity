  indentLevel: 0
  storyText: But Coach! We could still practise our finishing! Or our passing! Or
    maybe just a few sprints?
  description: 
  character: {fileID: 72338734}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
