  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 489
  indentLevel: 0
  storyText: Right, lads! I know the papers have given us plenty to talk about, but
    we've got a match in two days. Let's leave the headlines outside and focus on
    what actually matters.
