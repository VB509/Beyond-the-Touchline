  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 394
  indentLevel: 0
  storyText: What look? I'm just doing my job! Oh, and make sure you pick up tomorrow's
    Gazette. I think you'll find it rather interesting!
  description: 
  character: {fileID: 108388612}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
