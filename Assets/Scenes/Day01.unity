  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 52
  indentLevel: 0
  storyText: I'll leave you two to get acquainted, then. I'll be outside if you need
    me. Those bloody leaves won't sweep themselves!
  description: 
  character: {fileID: 1758483713}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
