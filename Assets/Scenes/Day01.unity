  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 326
  indentLevel: 0
  storyText: Aye, easy to say when you're the one holding the purse strings. Didn't
    think you'd be taking his side, lad. Not you.
  description: 
  character: {fileID: 1758483713}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
