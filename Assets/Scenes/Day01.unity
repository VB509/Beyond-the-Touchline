  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 625
  indentLevel: 0
  storyText: That's exactly what I want to hear. Save it for the match.
  description: 
  character: {fileID: 1688545919}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
