  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 620
  indentLevel: 0
  storyText: Finally! A manager who understands the importance of keeping his players
    alive. I knew there was something I liked about you, boss.
  description: 
  character: {fileID: 440430131}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
